# Copy to backend/.env and fill in. Never commit the real file.
ANTHROPIC_API_KEY=

# Optional model overrides (defaults live in fynn/config.py)
# FYNN_ROUTER_MODEL=claude-haiku-5-5
# FYNN_AGENT_MODEL=claude-sonnet-5-5
# FYNN_JUDGE_MODEL=claude-opus-5-5

# Browser origins allowed to call the API (comma-separated)
# FYNN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Limits on /chat for a public demo (unset: no limit). One question to both bots is two requests.
# FYNN_CHAT_LIMIT_PER_VISITOR_PER_HOUR=20
# FYNN_CHAT_LIMIT_PER_DAY=400
# Count visitors by X-Forwarded-For (behind a proxy). A client can set that header and the counts reset on restart,
# so neither limit bounds spending: keep the demo's key in its own Anthropic Console workspace with a monthly spend limit
# FYNN_TRUST_FORWARDED=1
