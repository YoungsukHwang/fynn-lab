{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "backend/.venv/bin/uvicorn",
      "runtimeArgs": [
        "api.main:app",
        "--app-dir", "backend",
        "--port", "8000",
        "--reload",
        "--reload-dir", "backend",
        "--reload-dir", "skills",
        "--reload-dir", "personas",
        "--reload-include", "*.md",
        "--reload-include", "*.json"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "web"],
      "port": 3000
    }
  ]
}
